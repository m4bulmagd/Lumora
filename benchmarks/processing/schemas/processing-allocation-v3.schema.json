{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "processing-allocation-v3.schema.json",
  "$comment": "Structural owned-artifact schema. EvidenceValidation.cpp additionally enforces canonical definitions/ordered row products, all cross-field arithmetic, duplicate decoded JSON keys, and on-disk payload and reviewed attachment integrity. Validation is not authority to designate or accept a workstation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "runStatus",
    "complete",
    "smoke",
    "generatedUtc",
    "rows",
    "failure",
    "sourceFormat"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "artifactType": {
      "const": "lumora.processing.allocation-proof"
    },
    "runStatus": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "smoke": {
      "type": "boolean"
    },
    "generatedUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rowId",
          "pipelineDefinition",
          "input",
          "sourceDescriptor",
          "orientation",
          "orientedDimensions",
          "provenance",
          "execution",
          "resourcePlan",
          "warmUpFrames",
          "measuredCycles",
          "positiveControl",
          "measuredRegion",
          "heapTrace",
          "processingErrors",
          "drops",
          "complete",
          "helperControl"
        ],
        "properties": {
          "rowId": {
            "enum": [
              "full_standard_identity",
              "full_standard_nonidentity"
            ]
          },
          "pipelineDefinition": {
            "$ref": "common.schema.json#/$defs/pipeline"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patternId",
              "version",
              "seed",
              "sha256",
              "derivation"
            ],
            "properties": {
              "patternId": {
                "const": "xorshift32_u16_v1"
              },
              "version": {
                "const": 1
              },
              "seed": {
                "const": 1831565813
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "derivation": {
                "const": "uint16(state >> 16) >> 4"
              }
            }
          },
          "sourceDescriptor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonicalName",
              "canonicalEncoding",
              "validBits",
              "sampleMaximum",
              "packing",
              "alignment",
              "applicationStorage",
              "nativeDimensions",
              "strideBytes",
              "payloadBytes"
            ],
            "properties": {
              "canonicalName": {
                "const": "Mono12"
              },
              "canonicalEncoding": {
                "const": 17825797
              },
              "validBits": {
                "const": 12
              },
              "sampleMaximum": {
                "const": 4095
              },
              "packing": {
                "const": "unpacked"
              },
              "alignment": {
                "const": "least_significant"
              },
              "applicationStorage": {
                "const": "uint16"
              },
              "nativeDimensions": {
                "$ref": "common.schema.json#/$defs/dimensions"
              },
              "strideBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "payloadBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            }
          },
          "orientation": {
            "$ref": "common.schema.json#/$defs/orientation"
          },
          "orientedDimensions": {
            "$ref": "common.schema.json#/$defs/dimensions"
          },
          "provenance": {
            "$ref": "common.schema.json#/$defs/provenance"
          },
          "execution": {
            "$ref": "common.schema.json#/$defs/execution"
          },
          "resourcePlan": {
            "$ref": "common.schema.json#/$defs/sessionResourceV2"
          },
          "warmUpFrames": {
            "enum": [
              2,
              100
            ]
          },
          "measuredCycles": {
            "enum": [
              20,
              1000
            ]
          },
          "positiveControl": {
            "$ref": "common.schema.json#/$defs/positiveControl"
          },
          "measuredRegion": {
            "$ref": "common.schema.json#/$defs/measuredRegion"
          },
          "heapTrace": {
            "$ref": "common.schema.json#/$defs/heapTrace"
          },
          "processingErrors": {
            "const": 0
          },
          "drops": {
            "const": 0
          },
          "complete": {
            "const": true
          },
          "helperControl": {
            "$ref": "common.schema.json#/$defs/helperControl"
          }
        }
      },
      "maxItems": 2
    },
    "failure": {
      "$ref": "common.schema.json#/$defs/failure"
    },
    "sourceFormat": {
      "const": "mono12"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "runStatus": {
            "const": "complete"
          },
          "failure": {
            "type": "null"
          },
          "rows": {
            "minItems": 2
          }
        }
      },
      "else": {
        "properties": {
          "runStatus": {
            "const": "incomplete"
          }
        }
      }
    }
  ]
}
