# Minimal string serialization for this one owned build-configuration object.
# This is applied to raw values after generator-expression evaluation, never to
# generator-expression syntax or shell commands.
function(lumora_json_string output value)
  string(REPLACE "\\" "\\\\" escaped "${value}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  foreach(code RANGE 1 31)
    string(ASCII ${code} control)
    math(EXPR hex "${code}" OUTPUT_FORMAT HEXADECIMAL)
    string(SUBSTRING "${hex}" 2 -1 hex)
    string(LENGTH "${hex}" length)
    if(length EQUAL 1)
      set(hex "0${hex}")
    endif()
    string(REPLACE "${control}" "\\u00${hex}" escaped "${escaped}")
  endforeach()
  set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(lumora_serialize_build_configuration input_dir output)
  foreach(name IN ITEMS configuration compiler-id compiler-version global-flags configuration-flags source-options)
    file(READ "${input_dir}/${name}.txt" raw)
    lumora_json_string(${name} "${raw}")
  endforeach()
  file(READ "${input_dir}/CXX/processing-options.txt" raw)
  lumora_json_string(processing_options "${raw}")
  file(READ "${input_dir}/CXX/evidence-options.txt" raw)
  lumora_json_string(evidence_options "${raw}")
  set(document "{\"configuration\":${configuration},\"compilerId\":${compiler-id},\"compilerVersion\":${compiler-version},\"cxxStandard\":20,\"compileOptions\":{\"scope\":\"declared_cmake_configuration_and_target_options\",\"global\":${global-flags},\"configuration\":${configuration-flags},\"processing\":${processing_options},\"evidence\":${evidence_options},\"sourceOptions\":${source-options}}}")
  set(${output} "${document}" PARENT_SCOPE)
endfunction()
