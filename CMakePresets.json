{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LUMORA_BUILD_TESTS": "ON",
        "LUMORA_BUILD_BENCHMARKS": "OFF",
        "LUMORA_ENABLE_BASLER": "OFF",
        "VCPKG_HOST_TRIPLET": "x64-linux-dynamic",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_qml_installed",
        "VCPKG_MANIFEST_FEATURES": "qml-ui",
        "LUMORA_BUILD_QML_UI": "ON",
        "LUMORA_BUILD_LEGACY_WIDGETS_TESTS": "OFF"
      }
    },
    {
      "name": "linux-gcc-debug-sim",
      "displayName": "Linux GCC Debug (QML simulator)",
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-release-sim",
      "displayName": "Linux GCC Release (QML simulator)",
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc-qml-base",
      "hidden": true,
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "LUMORA_BUILD_QML_UI": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_qml_installed",
        "VCPKG_MANIFEST_FEATURES": "qml-ui"
      }
    },
    {
      "name": "linux-gcc-debug-sim-qml",
      "displayName": "Linux GCC Debug (QML simulator compatibility preset)",
      "inherits": "linux-gcc-qml-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-release-sim-qml",
      "displayName": "Linux GCC Release (QML simulator compatibility preset)",
      "inherits": "linux-gcc-qml-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "LUMORA_BUILD_TESTS": "ON",
        "LUMORA_BUILD_BENCHMARKS": "OFF",
        "LUMORA_ENABLE_BASLER": "OFF",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_qml_installed",
        "LUMORA_BUILD_QML_UI": "ON",
        "LUMORA_BUILD_LEGACY_WIDGETS_TESTS": "OFF",
        "VCPKG_MANIFEST_FEATURES": "qml-ui"
      }
    },
    {
      "name": "windows-msvc-qml-base",
      "hidden": true,
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "LUMORA_BUILD_QML_UI": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_qml_installed",
        "VCPKG_MANIFEST_FEATURES": "qml-ui"
      }
    },
    {
      "name": "windows-msvc-debug-sim",
      "displayName": "Windows MSVC Debug (QML simulator)",
      "inherits": "windows-msvc-base"
    },
    {
      "name": "windows-msvc-release-sim",
      "displayName": "Windows MSVC Release (QML simulator)",
      "inherits": "windows-msvc-base"
    },
    {
      "name": "windows-msvc-debug-sim-qml",
      "displayName": "Windows MSVC Debug (QML simulator compatibility preset)",
      "inherits": "windows-msvc-qml-base"
    },
    {
      "name": "windows-msvc-release-sim-qml",
      "displayName": "Windows MSVC Release (QML simulator compatibility preset)",
      "inherits": "windows-msvc-qml-base"
    },
    {
      "name": "windows-msvc-debug-basler",
      "displayName": "Windows MSVC Debug (Basler)",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "LUMORA_ENABLE_BASLER": "ON"
      }
    },
    {
      "name": "windows-msvc-release-basler",
      "displayName": "Windows MSVC Release (Basler)",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "LUMORA_ENABLE_BASLER": "ON"
      }
    },
    {
      "name": "linux-gcc-debug-sim-legacy-tests",
      "displayName": "linux-gcc debug QML + legacy regression tests",
      "inherits": "linux-gcc-debug-sim",
      "cacheVariables": {
        "LUMORA_BUILD_LEGACY_WIDGETS_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "qml-ui;legacy-widgets-tests",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_legacy_tests_installed"
      }
    },
    {
      "name": "linux-gcc-release-sim-legacy-tests",
      "displayName": "linux-gcc release QML + legacy regression tests",
      "inherits": "linux-gcc-release-sim",
      "cacheVariables": {
        "LUMORA_BUILD_LEGACY_WIDGETS_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "qml-ui;legacy-widgets-tests",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_legacy_tests_installed"
      }
    },
    {
      "name": "windows-msvc-debug-sim-legacy-tests",
      "displayName": "windows-msvc debug QML + legacy regression tests",
      "inherits": "windows-msvc-debug-sim",
      "cacheVariables": {
        "LUMORA_BUILD_LEGACY_WIDGETS_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "qml-ui;legacy-widgets-tests",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_legacy_tests_installed"
      }
    },
    {
      "name": "windows-msvc-release-sim-legacy-tests",
      "displayName": "windows-msvc release QML + legacy regression tests",
      "inherits": "windows-msvc-release-sim",
      "cacheVariables": {
        "LUMORA_BUILD_LEGACY_WIDGETS_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "qml-ui;legacy-widgets-tests",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_legacy_tests_installed"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-gcc-debug-sim",
      "configurePreset": "linux-gcc-debug-sim"
    },
    {
      "name": "linux-gcc-release-sim",
      "configurePreset": "linux-gcc-release-sim"
    },
    {
      "name": "linux-gcc-debug-sim-qml",
      "configurePreset": "linux-gcc-debug-sim-qml"
    },
    {
